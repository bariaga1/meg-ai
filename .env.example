# Agent SDK HTTP base (local serve or Cursor-hosted URL).
# `npm run dev` sets this to http://127.0.0.1:3001 and starts the agent.
# If unset, /api/chat uses AI Gateway (on Vercel) or local lexical Meg.
# AGENT_BASE_URL=http://127.0.0.1:3001

# Optional bearer token for hosted / non-anonymous agent auth
# AGENT_BEARER_TOKEN=

# AI Gateway (organic chat without Cursor-hosted agent).
# On Vercel, OIDC is preferred — no key required in production.
# Locally: vercel env pull, or set a gateway API key.
# AI_GATEWAY_API_KEY=
# AI_GATEWAY_MODEL=google/gemini-2.5-flash

# Canonical site URL for Open Graph / LinkedIn previews (no trailing slash).
# After a custom domain: NEXT_PUBLIC_SITE_URL=https://your.domain
# NEXT_PUBLIC_SITE_URL=https://meg-ai-nine.vercel.app

# Force or disable modes
# MEG_FORCE_LOCAL=1
# MEG_DISABLE_GATEWAY=1
# MEG_DISABLE_LOCAL_FALLBACK=1
# MEG_USE_GATEWAY=1
