# AI Gateway credentials for real model answers.
# On Vercel, OIDC is automatic and no key is needed.
# Locally: `vercel env pull .env.local`, or set a Gateway API key.
# Without either, Meg answers in quick lookup mode (resume excerpts).
# AI_GATEWAY_API_KEY=
# AI_GATEWAY_MODEL=google/gemini-2.5-flash

# Canonical site URL for Open Graph / LinkedIn previews (no trailing slash).
# NEXT_PUBLIC_SITE_URL=https://itsomega.com

# Mode switches
# MEG_FORCE_LOCAL=1      # always use quick lookup mode
# MEG_DISABLE_GATEWAY=1  # same, but leaves MEG_FORCE_LOCAL free for tests
# MEG_USE_GATEWAY=1      # use Gateway locally with OIDC from `vercel env pull`
