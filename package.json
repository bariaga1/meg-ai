{
  "name": "meg-ai",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "dev:agent": "npx --yes @grok/agent-sdk@0.5.0 serve --dir . --mode single --dev --port 3001 --allow-anonymous",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "check:agent": "tsc --noEmit -p tsconfig.agent.json",
    "validate:agent": "npx --yes @grok/agent-sdk@0.5.0 validate --dir .",
    "smoke:retrieve": "npx --yes tsx scripts/smoke-retrieve.ts",
    "smoke:local": "npx --yes tsx scripts/smoke-local-meg.ts"
  },
  "dependencies": {
    "@grok/agent-sdk": "^0.5.0",
    "next": "^16.4.3",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "^16.4.3",
    "postcss": "^8",
    "tailwindcss": "^3.4.1",
    "tsx": "^4.23.15",
    "typescript": "^5"
  },
  "type": "module"
}
